# Copy to .env for local development. Never commit .env or real secrets.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/
MONGODB_DB_NAME=afsana_dev
JWT_SECRET=replace-with-at-least-32-random-characters
SITE_URL=http://localhost:8888
ALLOWED_ORIGINS=http://localhost:8888

# Production password-reset email (required in Netlify production)
RESEND_API_KEY=
EMAIL_FROM=

# Production distributed rate limiting (required in Netlify production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Keep false/empty in production. Setting true intentionally permits a local fallback during an outage.
RATE_LIMIT_FAIL_OPEN=false

# Only for local database setup scripts; never put these in Netlify.
ADMIN_EMAIL=
ADMIN_PASSWORD=
